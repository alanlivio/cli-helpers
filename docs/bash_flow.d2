vars: {
  d2-config: {
    theme-id: 1
    sketch: true
    layout-engine: elk
    pad: 0
  }
}

direction: right

bashrc: ".bashrc" {
  shape: rectangle
  icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/bash/bash-original.svg"
}

sh_init: "init.sh" {
  shape: rectangle
  icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/bash/bash-original.svg"
  style: {
    stroke-width: 2
    bold: true
  }
}

os_dependent: "os/*.sh\n..." {
  shape: rectangle
}

program_dependent: "programs/*.sh\ncompletions/*.sh" {
  shape: rectangle
}

dotfiles: "~/src/dotfiles/init.sh" {
  shape: rectangle
}

bashrc -> sh_init: loads
sh_init -> os_dependent: "1: loads OS modules"
sh_init -> program_dependent: "2: loads program & completion modules"
sh_init -> dotfiles: "3: loads dotfiles if present"
